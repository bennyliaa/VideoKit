# ktlint configuration for VideoKit (passed with --editorconfig; 13 §3 "Kotlin official style").
root = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
ktlint_code_style = intellij_idea
ktlint_standard_function-naming = disabled
ktlint_standard_filename = disabled
