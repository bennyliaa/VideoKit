  "finalFieldAuthority": "Developer must freeze one Schema/field table with source-gate-plan pins before independent B; these names are independent recommendations, not implemented API claims",
  "maps": [
    {
      "field": "factPreauthSha256",
      "evidence": "capture.externalPreauthSha256 = binding.preauthSha256 = hash(original approved template bytes)",
      "rule": "External digest is trusted launch input; no human identity proof"
    },
    {
      "field": "factRuntimeBindingSha256",
      "evidence": "capture.runtimeBindingSha256 = hash(original binding bytes)",
      "rule": "Do not regenerate binding from changed fields"
    },
    {
      "field": "factScope/factPlanId/factRunId/factNonce",
      "evidence": "capture.scope + original binding.scope/planId/runId/nonce + preauth template",
      "rule": "Capture does not itself carry every plan/run/nonce field"
    },
    {
      "field": "routeProofSha256/initialProofSha256",
      "evidence": "capture + original binding + same Gate receipt/proof hashes",
      "rule": "No file stand-in may assert original object return"
    },
    {
      "field": "collector/binder/gate/source pins",
      "evidence": "source20 seal + immutable receipts + exact frozen future target pins",
      "rule": "Future candidate target pins PLANNED; do not read floating source"
    },
    {
      "field": "rawSha256/rawBytes/items",
      "evidence": "original raw stdout + capture/fixed seven-query plan",
      "rule": "Reparse bytes; reject raw/status/time/order mismatch"
    },
    {
      "field": "factOuterReturnSha256/originalReturn",
      "evidence": "hash exact outer Observer receipt; original H identity/creation/image/argv/nonce + wait/readers/streams/close",
      "rule": "Body flags, controllerReturned, empty custody or exit file alone insufficient"
    },
    {
      "field": "home/services/systemPackages",
      "evidence": "facts model/api/firmware/user + exact HOME role/resolve/UID + external narrow review evidence",
      "rule": "systemFlag or OEM/issuer string alone cannot approve a service"
    },
    {
      "field": "targetScope/targetRunId/targetSourceSealSha256/targetPlanSha256",
      "evidence": "trusted target context; exact reviewed source/plan",
      "rule": "factScope != targetScope; no automatic install/media authority"
    },
    {
      "field": "collectedAtUtc/expiresAtUtc",
      "evidence": "original host collection instant; never review/export time",
      "rule": "0 <= now-collected < expiry-collected <= 300; now < expiry"
    },
    {
      "field": "reviewEvidenceSha256",
      "evidence": "explicit external approved raw review bytes + facts/outer/target/HOME/service digests",
      "rule": "Candidate export is always approved=false/REQUIRES_REVIEW"
    }
  ],
  "originalReturnClosedFields": [
    "waitReturned",
    "stdoutEOF",
    "stderrEOF",
    "originalPipesClosed",
    "originalHandleClosed",
    "controllerReturned",
    "unknown",
    "exitCode"
  ],
  "serviceClosedFields": [
    "packages",
