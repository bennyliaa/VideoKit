    "kind",
    "state",
    "category",
    "firmware",
    "evidenceSha256",
    "factScope",
    "validFromUtc",
    "validToUtc",
    "range"
  ],
  "rules": [
    "strict type, no bool/float as integer, no duplicate/case duplicate/extra keys",
    "Default export is not issuance; no real approval generated here",
    "Review must bind original evidence and exact target, not a caller issuer label",
    "V1 retains authority/approval; V2 must not synthesize them",
    "Unknown and global rejection preserve once/budgets; no rearm",
    "Original proof10/gate30 and facts90/15/SDK1 remain unchanged"
  ],
