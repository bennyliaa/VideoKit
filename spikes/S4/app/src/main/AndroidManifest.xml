<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="VideoKit S4" android:hardwareAccelerated="true">
        <activity
            android:name=".S4Activity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 15 §2.8: the export worker. No permissions; one process instance per task. -->
        <service
            android:name=".ExportWorkerService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":s4_worker" />
    </application>
</manifest>
