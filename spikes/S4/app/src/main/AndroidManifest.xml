<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="VideoKit S4" android:hardwareAccelerated="true">
        <activity
            android:name=".S4Activity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 15 §1.5 / §2.8 (option c1, user decision 2026-11-08): the export worker runs in a separate, non-isolated
             process of the app uid. Isolated processes cannot reach any codec (S4 attempts 1-4). The main process
             kills the worker after every task, so each task gets a fresh process. -->
        <service
            android:name=".ExportWorkerService"
            android:exported="false"
            android:process=":export" />
    </application>
</manifest>
